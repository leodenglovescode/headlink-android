    android:viewportHeight="108">

    <!-- left stem -->
    <path
        android:fillColor="#7FE3D0"
        android:pathData="M39,30 A6,6 0 0 1 45,36 V72 A6,6 0 0 1 39,78 A6,6 0 0 1 33,72 V36 A6,6 0 0 1 39,30 Z" />

    <!-- right stem -->
