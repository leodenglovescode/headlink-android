        android:fillColor="#7FE3D0"
        android:pathData="M69,30 A6,6 0 0 1 75,36 V72 A6,6 0 0 1 69,78 A6,6 0 0 1 63,72 V36 A6,6 0 0 1 69,30 Z" />

    <!-- link: the crossbar joining the two stems -->
    <path
        android:fillColor="#7FE3D0"
        android:pathData="M39,48 H69 A6,6 0 0 1 69,60 H39 A6,6 0 0 1 39,48 Z" />
</vector>
